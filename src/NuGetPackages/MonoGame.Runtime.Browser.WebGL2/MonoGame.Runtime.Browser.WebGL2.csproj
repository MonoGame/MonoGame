<Project Sdk="Microsoft.NET.Sdk.StaticWebAssets">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <StaticWebAssetBasePath>_monogame</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="BrowserGame.cs" Pack="true" PackagePath="buildTransitive" />
    <None Include="WebInterop.cs" Pack="true" PackagePath="buildTransitive" />
    <None Include="MonoGame.Runtime.Browser.WebGL2.targets" Pack="true" PackagePath="buildTransitive" />
    <Content Include="wwwroot\*.js" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Host\browser.runtimeconfig.template.json" Pack="true" PackagePath="buildTransitive\Host" />

    <Content Include="..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\libSDL2.a"
      Condition="Exists('..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\libSDL2.a')">
      <PackagePath>runtimes\browser-wasm\native</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\libFAudio.a"
      Condition="Exists('..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\libFAudio.a')">
      <PackagePath>runtimes\browser-wasm\native</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\mgruntime.a"
      Condition="Exists('..\..\..\Artifacts\native\mgruntime\webgl2\browser-wasm\Release\mgruntime.a')">
      <PackagePath>runtimes\browser-wasm\native</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
