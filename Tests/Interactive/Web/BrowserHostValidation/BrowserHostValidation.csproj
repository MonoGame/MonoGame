<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <AssemblyName>BrowserHostValidation</AssemblyName>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrowserHostValidation</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\MonoGame.Framework\MonoGame.Framework.Native.csproj" />
  </ItemGroup>

  <Import Project="..\Content\BuildContent.targets" />

  <!--
    browser-wasm currently does not reliably flow NativeFileReference items
    from referenced class libraries into the consuming app, so the validation
    harness imports the browser runtime props directly for now.
    See: https://github.com/dotnet/runtime/issues/114724
  -->
  <Import Project="..\..\..\..\src\NuGetPackages\MonoGame.Runtime.Browser.WebGL2\MonoGame.Runtime.Browser.WebGL2.props"
    Condition="Exists('..\..\..\..\src\NuGetPackages\MonoGame.Runtime.Browser.WebGL2\MonoGame.Runtime.Browser.WebGL2.props')" />

</Project>
