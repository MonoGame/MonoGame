<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <AssemblyName>BrowserHostValidation</AssemblyName>
    <OutputType>Exe</OutputType>
    <RootNamespace>BrowserHostValidation</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\MonoGame.Framework\MonoGame.Framework.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="index.html" />
    <None Remove="main.js" />

    <Content Include="index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="main.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\..\..\MonoGame.Framework\Platform\Web\Host\host.css">
      <Link>host.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\..\..\MonoGame.Framework\Platform\Web\Host\monogame-web-host.js">
      <Link>monogame-web-host.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    browser-wasm currently does not reliably flow NativeFileReference items
    from referenced class libraries into the consuming app, so the validation
    harness imports the browser runtime props directly for now.
    See: https://github.com/dotnet/runtime/issues/114724
  -->
  <Import Project="..\..\..\..\src\NuGetPackages\MonoGame.Runtime.Browser.WebGL2\MonoGame.Runtime.Browser.WebGL2.props"
    Condition="Exists('..\..\..\..\src\NuGetPackages\MonoGame.Runtime.Browser.WebGL2\MonoGame.Runtime.Browser.WebGL2.props')" />

</Project>
